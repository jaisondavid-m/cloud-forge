# ============================================================
# CloudForge Site-2 (Recovery Site) Backend Configuration
# ============================================================

# AWS EFS Mount directory path on the EC2 instance / host
# On Linux EC2: /mnt/efs/shared
# For local dual-site testing: ../../Site-1/backend/storage
EFS_MOUNT_PATH=../../Site-1/backend/storage

# Server configuration (Default port 8001 avoids conflict with Site-1 on 8000)
HOST=0.0.0.0
PORT=8001

# Site identification
SITE_NAME=Site-2 (Recovery Site)
SITE_ID=site-2
READ_ONLY_MODE=true

# CORS Allowed Origins
FRONTEND_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173

# Safety limits
MAX_PREVIEW_BYTES=1048576
MAX_FILE_LIST_COUNT=1000
