# ============================================================
# CloudForge (Site-1) Shared Cloud File Storage Environment Configuration
# ============================================================

# Shared EFS Directory path on the EC2 instance or local host
# Production Linux EC2: /mnt/efs/shared
# Local development: ./storage
EFS_MOUNT_PATH=./storage

# Backend server host & port
HOST=0.0.0.0
PORT=8000

# Site identification
SITE_NAME=Site-1 (Primary)
SITE_ID=site-1

# CORS: Allowed origins for frontend access (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Upload limit (in Megabytes)
MAX_UPLOAD_SIZE_MB=10
