# AWS EFS Mount directory path on the host / EC2 instance
# On Linux EC2: /mnt/efs/shared or /var/cloudforge/efs
# For local development: ./storage (or any relative/absolute path)
EFS_MOUNT_PATH=./storage

# Server configuration
HOST=0.0.0.0
PORT=8000

# Site identity
SITE_NAME=Site-1 (Primary)
SITE_ID=site-1

# CORS Allowed Origins (comma-separated or single)
# In development: http://localhost:5173
# In production: http://<EC2-PUBLIC-IP>:5173 or https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Upload restrictions
MAX_UPLOAD_SIZE_MB=10
