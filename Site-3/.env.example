# ============================================================
# CloudForge Site-2 (Recovery Site) Environment Configuration
# ============================================================

# Shared EFS Directory path on the EC2 instance
# Production Linux EC2: /mnt/efs/shared
# Local dual-site testing: ../../Site-1/backend/storage
EFS_MOUNT_PATH=../../Site-1/backend/storage

# Backend server host & port (8001 avoids conflict with Site-1 on 8000)
HOST=0.0.0.0
PORT=8001

# Site identification
SITE_NAME=Site-2 (Recovery Site)
SITE_ID=site-2
READ_ONLY_MODE=true

# CORS Allowed Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Safety limits
MAX_PREVIEW_BYTES=1048576
MAX_FILE_LIST_COUNT=1000
